# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/insight_analyzer
DATABASE_SSL=false

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
ADMIN_PASSWORD=change_this_to_your_admin_password

# ─── ML Service ──────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─── Development Mode ────────────────────────────────────────────────────────
# Set to true to use mock data instead of real API calls (for development)
USE_MOCK_SERVICE=true

# ─── Instagram Graph API ─────────────────────────────────────────────────────
# Get from: https://developers.facebook.com/
# Requires: instagram_basic, instagram_manage_comments permissions
IG_ACCESS_TOKEN=
IG_USER_ID=

# ─── TikTok Research API ─────────────────────────────────────────────────────
# Get from: https://developers.tiktok.com/
# Requires: Approved Research API application
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
