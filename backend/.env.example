# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/insight_analyzer
DATABASE_SSL=false

# ─── Auth ────────────────────────────────────────────────────────────────────
# Ganti dengan string acak panjang (min 32 karakter) — jangan gunakan contoh ini di production!
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
# Password untuk login ke aplikasi
ADMIN_PASSWORD=change_this_to_your_admin_password

# ─── ML Service ──────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
